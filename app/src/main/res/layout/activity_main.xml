<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F8"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="32dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp"
    tools:context=".MainActivity">

    <!-- Header Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/purple_header_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Experiment 11: Display Google Maps"
                android:textColor="@color/purple_title"
                android:textSize="17sp"
                android:textStyle="bold" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvStudentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Name: vishwajeet singh"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStudentUSN"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="USN: 25MCAR0219"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Map Type Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMapNormal"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:text="Normal"
            android:textColor="#5C428C"
            android:textSize="12sp"
            app:cornerRadius="20dp"
            app:strokeColor="#C8B2E4"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMapSatellite"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:text="Satellite"
            android:textColor="#5C428C"
            android:textSize="12sp"
            app:cornerRadius="20dp"
            app:strokeColor="#C8B2E4"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMapTerrain"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:text="Terrain"
            android:textColor="#5C428C"
            android:textSize="12sp"
            app:cornerRadius="20dp"
            app:strokeColor="#C8B2E4"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMapHybrid"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:text="Hybrid"
            android:textColor="#5C428C"
            android:textSize="12sp"
            app:cornerRadius="20dp"
            app:strokeColor="#C8B2E4"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- Search Input & Search Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etSearchCity"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:autofillHints="postalAddress"
            android:background="@color/white"
            android:hint="Enter city or place (e.g. Bengaluru)"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_dark"
            android:textColorHint="#9E9E9E"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:backgroundTint="@color/search_blue"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Search"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:cornerRadius="24dp" />
    </LinearLayout>

    <!-- Quick City Preset Chips Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipBengaluru"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/chip_purple"
                android:text="Bengaluru"
                android:textColor="@color/chip_purple_text"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipNewDelhi"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/chip_purple"
                android:text="New Delhi"
                android:textColor="@color/chip_purple_text"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipMumbai"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/chip_purple"
                android:text="Mumbai"
                android:textColor="@color/chip_purple_text"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipTajMahal"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/chip_purple"
                android:text="Taj Mahal"
                android:textColor="@color/chip_purple_text"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipRanchi"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/chip_purple"
                android:text="Ranchi"
                android:textColor="@color/chip_purple_text"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:strokeWidth="0dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Map Container Frame with Overlays -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Interactive Map WebView -->
        <WebView
            android:id="@+id/webViewMap"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Top Dark Overlay Bar -->
        <LinearLayout
            android:id="@+id/layoutTopOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:background="@color/overlay_black_bg"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvTopOverlayText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loc: Bengaluru (12.972, 77.595) | USN: 25MCAR0219 | vishwajeet singh"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Right Side Controls (Zoom In, Zoom Out, Location) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Zoom In -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardZoomIn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/purple_header_bg"
                app:cardCornerRadius="10dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/black"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Zoom Out -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardZoomOut"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/purple_header_bg"
                app:cardCornerRadius="10dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="─"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <!-- My Location FAB -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabMyLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Current Location"
                android:src="@drawable/ic_my_location"
                app:backgroundTint="@color/purple_header_bg"
                app:fabCustomSize="44dp"
                app:maxImageSize="22dp"
                app:tint="@color/purple_title" />
        </LinearLayout>

        <!-- Bottom Left Overlay Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Google Maps - Exp 11"
                    android:textColor="@color/black"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBottomOverlayInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USN: 25MCAR0219 | Name: vishwajeet singh"
                    android:textColor="@color/black"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvBottomOverlayLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Location: Bengaluru (12.9716, 77.5946)"
                    android:textColor="@color/black"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>
</LinearLayout>
